<div class="project-header">
  <h1><%= @project.name %></h1>
  <p class="created-by">Created by: <%= @project.user.email %></p>
</div>

<div class="project-actions">
  <% if @project.admin?(current_user) %>
    <%= link_to "Edit Project", edit_project_path(@project), class: "btn-edit" %>
  <% end %>
  <%= link_to "Back to projects", projects_path, class: "btn-back" %>
</div>

<hr>

<p class="project-description"><%= @project.description %></p>

<div class="members-section">
  <h3>Members</h3>
  <ul class="members-list">
    <% @project.all_participants.each do |participant| %>
      <li>
        <%= participant.email %>
        <% if @project.admin?(participant) %>
          <span class="admin-badge">Admin</span>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>

<hr>

<!-- DISCUSSIONS -->
<section class="section-block">
  <h2>Discussions</h2>

  <%= form_with(url: project_topics_path(@project), method: :post, local: true, class: "inline-form") do |f| %>
    <div class="form-row">
      <%= f.text_field :title, name: "topic[title]", required: true, placeholder: "Discussion title..." %>
      <%= f.submit "New Discussion", class: "btn-primary" %>
    </div>
  <% end %>

  <% @project.topics.order(created_at: :desc).each do |topic| %>
    <div id="topic-<%= topic.id %>" class="topic-card">
      <div class="topic-header">
        <h3><%= topic.title %></h3>
        <small>by <%= topic.user.email %></small>
        <% if topic.user == current_user %>
          <%= button_to "Delete", project_topic_path(@project, topic), method: :delete, data: { confirm: "Are you sure?" }, class: "btn-delete-small" %>
        <% end %>
      </div>

      <div class="messages-container">
        <% topic.messages.order(:created_at).each do |message| %>
          <div class="message-bubble">
            <strong><%= message.user.email %>:</strong>
            <%= message.content %>
            <% if message.user == current_user %>
              <%= button_to "×", project_topic_message_path(@project, topic, message), method: :delete, data: { confirm: "Delete?" }, class: "btn-delete-x" %>
            <% end %>
          </div>
        <% end %>

        <%= form_with(url: project_topic_messages_path(@project, topic), method: :post, local: true, class: "message-form") do |f| %>
          <%= f.text_field :content, name: "message[content]", placeholder: "Type a message...", required: true %>
          <%= f.submit "Send", class: "btn-primary" %>
        <% end %>
      </div>
    </div>
  <% end %>
</section>

<hr>

<!-- TASKS -->
<section class="section-block">
  <h2>Tasks</h2>

  <%= form_with(url: project_tasks_path(@project), method: :post, local: true, class: "inline-form") do |f| %>
    <div class="form-row">
      <%= f.text_field :title, name: "task[title]", required: true, placeholder: "Task title..." %>
      <%= f.submit "New Task", class: "btn-primary" %>
    </div>
  <% end %>

  <ul class="tasks-list">
    <% @project.tasks.order(created_at: :desc).each do |task| %>
      <li class="task-item <%= 'task-completed' if task.completed %>">
        <%= button_to (task.completed ? "[x]" : "[ ]"), project_task_path(@project, task), method: :patch, form: { style: "display: inline" }, class: "task-checkbox" %>
        
        <span class="task-title">
          <% if task.completed %>
            <s><%= task.title %></s>
          <% else %>
            <%= task.title %>
          <% end %>
        </span>
        
        <small class="task-author">(by <%= task.user.email %>)</small>
        
        <%= button_to "Delete", project_task_path(@project, task), method: :delete, data: { confirm: "Delete?" }, form: { style: "display: inline" }, class: "btn-delete-small" %>
      </li>
    <% end %>
  </ul>
</section>

<hr>

<!-- ATTACHMENTS -->
<section class="section-block">
  <h2>Attachments</h2>

  <%= form_with(url: project_attachments_path(@project), method: :post, local: true, multipart: true, class: "inline-form") do |f| %>
    <div class="form-row">
      <%= f.file_field :files, multiple: true, name: "files[]" %>
      <%= f.submit "Upload", class: "btn-primary" %>
    </div>
  <% end %>

  <% if @project.attachments.any? %>
    <ul class="attachments-list">
      <% @project.attachments.each do |attachment| %>
        <li class="attachment-item">
          <%= link_to attachment.filename, rails_blob_path(attachment, disposition: "attachment"), class: "attachment-link" %>
          <small>(<%= number_to_human_size(attachment.byte_size) %>)</small>
          <%= button_to "Delete", project_attachment_path(@project, attachment.id), method: :delete, data: { confirm: "Delete this file?" }, form: { style: "display: inline" }, class: "btn-delete-small" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty-state">No attachments yet.</p>
  <% end %>
</section>