<h1>Projects</h1>

<%= link_to "+ Add Project", new_project_path %>

<div style="margin: 20px 0;">
  <%= link_to "✱ All projects", projects_path %> |
  <%= link_to "✏ Created by me", projects_path(filter: "created") %> |
  <%= link_to "👥 Shared with me", projects_path(filter: "shared") %>
</div>

<div>
  <% if @projects.any? %>
    <% @projects.each do |project| %>
      <div style="border: 1px solid #ccc; padding: 10px; margin: 10px;">
        <h3><%= link_to project.name, project %></h3>
        <p>👤 <%= project.user.email %></p>
        <p><%= project.description %></p>
        <p>👥 <%= project.members.count %> members</p>
        <% if project.user == current_user %>
          <%= button_to "Delete", project, method: :delete, data: { confirm: "Are you sure?" } %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <p>No projects yet.</p>
  <% end %>
</div>