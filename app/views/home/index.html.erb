<div class="landing">
  <div class="landing-icon">
    <svg width="100" height="100" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
      <circle cx="50" cy="35" r="20" fill="none" stroke="#00a3a3" stroke-width="4"/>
      <path d="M 30 55 Q 50 75 70 55" fill="none" stroke="#00a3a3" stroke-width="4" stroke-linecap="round"/>
      <path d="M 25 45 Q 15 55 20 75" fill="none" stroke="#00a3a3" stroke-width="4" stroke-linecap="round"/>
      <path d="M 75 45 Q 85 55 80 75" fill="none" stroke="#00a3a3" stroke-width="4" stroke-linecap="round"/>
    </svg>
  </div>
  <h1 class="landing-title">COLLABORATE</h1>
  <p class="landing-subtitle">A project management tool for developers</p>

  <div class="landing-buttons">
    <% if user_signed_in? %>
      <%= link_to "My Projects", projects_path, class: "btn-primary btn-large" %>
    <% else %>
      <%= link_to "Sign up", new_user_registration_path, class: "btn-primary btn-large" %>
      <%= link_to "Login", new_user_session_path, class: "btn-primary btn-large" %>
    <% end %>
  </div>
</div>
